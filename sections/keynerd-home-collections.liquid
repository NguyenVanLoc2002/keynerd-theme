{% liquid
  assign cards = 'Artisan Keycaps|/collections/artisan-keycaps|Handmade resin keycaps and character-inspired keyboard art.,Pokemon-Inspired Keycaps|/collections/pokemon-inspired-keycaps|Collectible Pokemon-inspired designs for playful mechanical keyboards.,Personalized Gifts|/collections/personalized-gifts|Custom figurines and keepsakes made from photos and personal ideas.,Supplies & Accessories|/collections/supplies-accessories|Molds, keychains, and accessories for keyboard and resin craft fans.' | split: ','
%}

<section class="keynerd-home-collections section section--page-width spacing-style" style="--padding-block-start: 48px; --padding-block-end: 64px;">
  <div class="keynerd-home-collections__header">
    <h2>Shop by Collection</h2>
  </div>
  <div class="keynerd-home-collections__grid">
    {% for card in cards %}
      {% assign parts = card | split: '|' %}
      <a class="keynerd-home-collections__card" href="{{ parts[1] }}">
        <span class="keynerd-home-collections__title">{{ parts[0] }}</span>
        <span class="keynerd-home-collections__text">{{ parts[2] }}</span>
      </a>
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .keynerd-home-collections__header {
    margin-bottom: 16px;
  }

  .keynerd-home-collections__header h2 {
    margin: 0;
  }

  .keynerd-home-collections__grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 12px;
  }

  .keynerd-home-collections__card {
    min-height: 260px;
    aspect-ratio: 4 / 5;
    border-radius: 10px;
    padding: 18px;
    color: rgb(var(--color-foreground-rgb));
    text-decoration: none;
    background: linear-gradient(135deg, rgb(var(--color-foreground-rgb) / 0.08), rgb(var(--color-foreground-rgb) / 0.02));
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 8px;
  }

  .keynerd-home-collections__title {
    font: var(--font-h5--style) var(--font-h5--weight) var(--font-h5--size) / var(--font-h5--line-height) var(--font-heading--family);
  }

  .keynerd-home-collections__text {
    font-size: 0.875rem;
    line-height: 1.4;
    max-width: 26ch;
  }

  @media screen and (max-width: 749px) {
    .keynerd-home-collections__grid {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }

    .keynerd-home-collections__card {
      min-height: 180px;
      padding: 14px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "KeyNerd collections",
  "settings": [],
  "presets": [
    {
      "name": "KeyNerd collections"
    }
  ]
}
{% endschema %}