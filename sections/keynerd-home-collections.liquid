{% liquid
  assign cards = 'Artisan Keycaps|/collections/artisan-keycaps|Handmade resin keycaps and sculpted keyboard art.|card-small|keycap,Pokemon-Inspired Keycaps|/collections/pokemon-inspired-keycaps|Collectible character-inspired keycaps for playful mechanical keyboards.|card-wide|pokemon,Personalized Gifts|/collections/personalized-gifts|Custom figurines and keepsakes made from photos and personal ideas.|card-half|gifts,Supplies & Accessories|/collections/supplies-accessories|Molds, keychains, and accessories for keyboard and resin craft fans.|card-half|supplies' | split: ','
%}

<section class="keynerd-home-collections section section--page-width">
  <div class="keynerd-home-collections__header">
    <h2>Shop by Collection</h2>
  </div>

  <div class="keynerd-home-collections__grid">
    {% for card in cards %}
      {% assign parts = card | split: '|' %}
      <a class="keynerd-home-collections__card keynerd-home-collections__card--{{ parts[3] }} keynerd-home-collections__card--{{ parts[4] }}" href="{{ parts[1] }}">
        <span class="keynerd-home-collections__title">{{ parts[0] }}</span>
        <span class="keynerd-home-collections__text">{{ parts[2] }}</span>
      </a>
    {% endfor %}
  </div>
</section>

{% stylesheet %}
  .keynerd-home-collections {
    padding-block: 48px 64px;
  }

  .keynerd-home-collections__header {
    display: flex;
    justify-content: center;
    margin-bottom: 32px;
  }

  .keynerd-home-collections__header h2 {
    margin: 0;
    font-size: clamp(2.25rem, 4vw, 4rem);
    line-height: 1;
    font-family: var(--font-heading--family);
    font-weight: 400;
  }

  .keynerd-home-collections__grid {
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    grid-auto-rows: minmax(180px, auto);
    gap: 16px;
  }

  .keynerd-home-collections__card {
    position: relative;
    min-height: 260px;
    border-radius: 10px;
    overflow: hidden;
    padding: 24px;
    color: rgb(var(--color-background-rgb));
    text-decoration: none;
    display: flex;
    flex-direction: column;
    justify-content: flex-end;
    gap: 8px;
    background:
      linear-gradient(180deg, rgb(0 0 0 / 0.08), rgb(0 0 0 / 0.48)),
      radial-gradient(circle at 22% 18%, rgb(253 198 86 / 0.7), transparent 30%),
      linear-gradient(135deg, #4f594c, #171815 60%, #8b673f);
  }

  .keynerd-home-collections__card--card-small {
    grid-column: span 4;
    min-height: 280px;
  }

  .keynerd-home-collections__card--card-wide {
    grid-column: span 8;
    min-height: 280px;
  }

  .keynerd-home-collections__card--card-half {
    grid-column: span 6;
    min-height: 230px;
  }

  .keynerd-home-collections__card--pokemon {
    background:
      linear-gradient(180deg, rgb(0 0 0 / 0.06), rgb(0 0 0 / 0.5)),
      radial-gradient(circle at 70% 22%, rgb(253 198 86 / 0.75), transparent 30%),
      linear-gradient(135deg, #2f4138, #18160f 55%, #9c6a2b);
  }

  .keynerd-home-collections__card--gifts {
    background:
      linear-gradient(180deg, rgb(0 0 0 / 0.04), rgb(0 0 0 / 0.52)),
      radial-gradient(circle at 28% 18%, rgb(195 204 166 / 0.75), transparent 32%),
      linear-gradient(135deg, #5b4d45, #171412 62%, #8d7660);
  }

  .keynerd-home-collections__card--supplies {
    background:
      linear-gradient(180deg, rgb(0 0 0 / 0.04), rgb(0 0 0 / 0.52)),
      radial-gradient(circle at 70% 18%, rgb(173 196 194 / 0.8), transparent 32%),
      linear-gradient(135deg, #344343, #171817 62%, #6e6f63);
  }

  .keynerd-home-collections__title {
    font-size: clamp(1.35rem, 2vw, 1.85rem);
    line-height: 1.1;
    font-weight: 600;
  }

  .keynerd-home-collections__text {
    max-width: 34ch;
    font-size: 0.9375rem;
    line-height: 1.4;
  }

  @media screen and (max-width: 749px) {
    .keynerd-home-collections {
      padding-block: 36px 48px;
    }

    .keynerd-home-collections__header {
      justify-content: flex-start;
      margin-bottom: 20px;
    }

    .keynerd-home-collections__grid {
      grid-template-columns: 1fr;
      gap: 12px;
    }

    .keynerd-home-collections__card,
    .keynerd-home-collections__card--card-small,
    .keynerd-home-collections__card--card-wide,
    .keynerd-home-collections__card--card-half {
      grid-column: span 1;
      min-height: 190px;
      padding: 18px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "KeyNerd collections",
  "settings": [],
  "presets": [
    {
      "name": "KeyNerd collections"
    }
  ]
}
{% endschema %}